Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Name: Grid
      Plane Cell Count: 12
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Marker Scale: 0.3
      Show Axes: true
      Show Names: false
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Name: RobotModel
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: "1 - RGB"
      Topic:
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /overhead_rgb/image_raw
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: "2 - Depth CLEAN"
      Topic:
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /overhead_depth/depth/image_raw
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: "3 - Depth NOISY (injected)"
      Topic:
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /overhead_depth/depth/image_noisy
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: AxisColor
      Name: "4 - Cloud CLEAN"
      Size (m): 0.004
      Style: Points
      Topic:
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /overhead_depth/points
      Value: true
    - Class: rviz_default_plugins/DepthCloud
      Name: "5 - Cloud NOISY (injected)"
      Enabled: true
      Color Image Topic: /overhead_rgb/image_raw
      Depth Map Topic: /overhead_depth/depth/image_noisy
      Queue Size: 5
      Style: Points
      Auto Size: true
      Value: true
  Global Options:
    Background Color: 38; 38; 38
    Fixed Frame: xarm_base_link
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.5
      Focal Point:
        X: 0.2
        Y: 0.0
        Z: 0.25
      Name: Current View
      Pitch: 0.55
      Yaw: 0.7
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Width: 1700
  Views:
    collapsed: false
