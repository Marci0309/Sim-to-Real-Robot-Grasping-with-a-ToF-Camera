<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>xarm1s_manipulation</name>
  <version>0.1.0</version>
  <description>
    Closed-loop pick-and-place for the xArm 1S sim (Phase 4A): analytical 5-DoF
    IK, perception-driven slanted grasp, soft-attach capture model, and
    pick-success / placement-error logging. Phase 4C adds a ROS-free real-arm
    control bridge (grasp_common / servo_calib / real_arm_driver / scripts) that
    drives the physical Hiwonder xArm 1S over USB-HID.
  </description>
  <maintainer email="szokedencsim@gmail.com">Marcell Mor Szokedencsi</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- Phase 4C real-arm path runs on a WINDOWS host with plain CPython and needs
       `pip install xarm hidapi` (USB-HID xArm 1S). These are NOT rosdep keys and
       are intentionally not exec_depends: the real bridge does not run under ROS.
       The sim (Phase 4A) has no such dependency. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
