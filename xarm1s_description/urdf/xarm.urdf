<?xml version="1.0" ?>
<robot name="xarm">
    <material name="DarkGrey">
        <color rgba="0.3 0.3 0.3 1.0" />
    </material>
    <material name="Red">
        <color rgba="0.3 0.3 0.3 1.0" />
    </material>
    <material name="Black">
        <color rgba="0 0 0 1.0" />
    </material>
    <material name="Orange">
        <color rgba="0.0 0.15 0.7 1.0" />
    </material>
    <material name="Silver">
        <color rgba="1.0 1.0 1.0 1.0" />
    </material>
    <material name="Grey">
        <color rgba="0.7 0.7 0.7 1.0" />
    </material>
    <material name="Blue">
        <color rgba="0.0 0.0 0.8 1.0" />
    </material>
    <material name="HandGray">
        <color rgba="0.953 0.996 0.694 1.0" />
    </material>
    <material name="SickBlue">
        <color rgba="0.3058 0.5921 0.7294 1.0" />
    </material>

    <link name="xarm_base_link">
        <visual>
            <origin rpy="0 0 0" xyz="0.0 0.0 0.0" />
            <geometry>
                <mesh filename="package://xarm1s_description/meshes/base.stl" scale="1.0 1.0 1.0" />
            </geometry>
            <material name="Blue" />
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <geometry>
                <mesh filename="package://xarm1s_description/meshes/base.stl" scale="1.0 1.0 1.0" />
            </geometry>
        </collision>
        <inertial>
            <mass value="0.1" />
            <inertia ixx="0.03" iyy="0.03" izz="0.03" ixy="0.0" ixz="0.0" iyz="0.0" />
        </inertial>
    </link>

    <link name="xarm_6_link">
        <visual>
            <origin rpy="0 0 0" xyz="0.0 0.0 0.0" />
            <geometry>
                <mesh filename="package://xarm1s_description/meshes/link6.stl" scale="1.0 1.0 1.0" />
            </geometry>
            <material name="DarkGrey" />
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0.0 0.0 0.0" />
            <geometry>
                <mesh filename="package://xarm1s_description/meshes/link6.stl" scale="1.0 1.0 1.0" />
            </geometry>
        </collision>
        <inertial>
            <mass value="0.1" />
            <inertia ixx="0.03" iyy="0.03" izz="0.03" ixy="0.0" ixz="0.0" iyz="0.0" />
        </inertial>
    </link>

    <link name="xarm_5_link">
        <visual>
            <origin rpy="0 0 0" xyz="0.0 0.0 0.0" />
            <geometry>
                <mesh filename="package://xarm1s_description/meshes/link5.stl" scale="1.0 1.0 1.0" />
            </geometry>
            <material name="Blue" />
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0.0 0.0 0.0" />
            <geometry>
                <mesh filename="package://xarm1s_description/meshes/link5.stl" scale="1.0 1.0 1.0" />
            </geometry>
        </collision>
        <inertial>
            <mass value="0.1" />
            <inertia ixx="0.03" iyy="0.03" izz="0.03" ixy="0.0" ixz="0.0" iyz="0.0" />
        </inertial>
    </link>

    <link name="xarm_4_link">
        <visual>
            <origin rpy="0 0 0" xyz="0.0 0.0 0.0" />
            <geometry>
                <mesh filename="package://xarm1s_description/meshes/link4.stl" scale="1.0 1.0 1.0" />
            </geometry>
            <material name="DarkGrey" />
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0.0 0.0 0.0" />
            <geometry>
                <mesh filename="package://xarm1s_description/meshes/link4.stl" scale="1.0 1.0 1.0" />
            </geometry>
        </collision>
        <inertial>
            <mass value="0.1" />
            <inertia ixx="0.03" iyy="0.03" izz="0.03" ixy="0.0" ixz="0.0" iyz="0.0" />
        </inertial>
    </link>

    <link name="xarm_3_link">
        <visual>
            <origin rpy="0 0 0" xyz="0.0 0.0 0.0" />
            <geometry>
                <mesh filename="package://xarm1s_description/meshes/link3.stl" scale="1.0 1.0 1.0" />
            </geometry>
            <material name="Blue" />
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0.0 0.0 0.0" />
            <geometry>
                <mesh filename="package://xarm1s_description/meshes/link3.stl" scale="1.0 1.0 1.0" />
            </geometry>
        </collision>
        <inertial>
            <mass value="0.1" />
            <inertia ixx="0.03" iyy="0.03" izz="0.03" ixy="0.0" ixz="0.0" iyz="0.0" />
        </inertial>
    </link>

    <link name="xarm_2_link">
        <visual>
            <origin rpy="0 0 0" xyz="0.0 0.0 0.0" />
            <geometry>
                <mesh filename="package://xarm1s_description/meshes/link2.stl" scale="1.0 1.0 1.0" />
            </geometry>
            <material name="DarkGrey" />
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0.0 0.0 0.0" />
            <geometry>
                <mesh filename="package://xarm1s_description/meshes/link2.stl" scale="1.0 1.0 1.0" />
            </geometry>
        </collision>
        <inertial>
            <mass value="0.1" />
            <inertia ixx="0.03" iyy="0.03" izz="0.03" ixy="0.0" ixz="0.0" iyz="0.0" />
        </inertial>
    </link>

    <joint name="xarm_6_joint" type="revolute">
        <origin rpy="0 0 0" xyz="0 0.0 0.03603" />
        <axis xyz="0 0 1" />
        <limit effort="1000" lower="-1.737238322" upper="1.79965407" velocity="1.0" />
        <parent link="xarm_base_link" />
        <child link="xarm_6_link" />
    </joint>

    <joint name="xarm_5_joint" type="revolute">
        <origin rpy="0 0 0" xyz="0 -0.0022 0.03195" />
        <axis xyz="1 0 0" />
        <limit effort="1000" lower="-1.592023304" upper="1.86797401" velocity="1.0" />
        <parent link="xarm_6_link" />
        <child link="xarm_5_link" />
    </joint>

    <joint name="xarm_4_joint" type="revolute">
        <origin rpy="0 0 0" xyz="0 0.0 0.09765" />
        <axis xyz="1 0 0" />
        <limit effort="1000" lower="-1.910427965" upper="1.910427965" velocity="1.0" />
        <parent link="xarm_5_link" />
        <child link="xarm_4_link" />
    </joint>

    <joint name="xarm_3_joint" type="revolute">
        <origin rpy="0 0 0" xyz="0 0.0 0.09825" />
        <axis xyz="1 0 0" />
        <limit effort="1000" lower="-1.740612146" upper="1.86797401" velocity="1.0" />
        <parent link="xarm_4_link" />
        <child link="xarm_3_link" />
    </joint>

    <joint name="xarm_2_joint" type="revolute">
        <origin rpy="0 0 0" xyz="0 -0.001205 0.05306" />
        <axis xyz="0 0 1" />
        <limit effort="1000" lower="-2.17494876" upper="1.63121157" velocity="1.0" />
        <parent link="xarm_3_link" />
        <child link="xarm_2_link" />
    </joint>

    <transmission name="trans_xarm_6_joint">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="xarm_6_joint">
            <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        </joint>
        <actuator name="xarm_6_joint_motor">
            <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>

    <transmission name="trans_xarm_5_joint">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="xarm_5_joint">
            <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        </joint>
        <actuator name="xarm_5_joint_motor">
            <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>

    <transmission name="trans_xarm_4_joint">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="xarm_4_joint">
            <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        </joint>
        <actuator name="xarm_4_joint_motor">
            <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>

    <transmission name="trans_xarm_3_joint">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="xarm_3_joint">
            <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        </joint>
        <actuator name="xarm_3_joint_motor">
            <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>

    <transmission name="trans_xarm_2_joint">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="xarm_2_joint">
            <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        </joint>
        <actuator name="xarm_2_joint_motor">
            <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>

    <!-- ===== ros2_control hardware interface ===== -->
    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>
        <joint name="xarm_2_joint">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="xarm_3_joint">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="xarm_4_joint">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="xarm_5_joint">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="xarm_6_joint">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="gripper_left_finger_joint">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="gripper_right_finger_joint">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>

    <gazebo>
        <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
            <parameters>$(find xarm1s_description)/config/controllers.yaml</parameters>
        </plugin>
    </gazebo>

    <!-- End effector tool frame -->
    <!-- ========== OVERHEAD RGB-D CAMERA ========== -->
    <link name="overhead_camera_mount">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry><box size="0.05 0.05 0.02"/></geometry>
            <material name="Black"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry><box size="0.05 0.05 0.02"/></geometry>
        </collision>
        <inertial><mass value="0.1"/>
            <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <link name="overhead_camera_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry><box size="0.04 0.09 0.03"/></geometry>
            <material name="SickBlue"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry><box size="0.04 0.09 0.03"/></geometry>
        </collision>
        <inertial><mass value="0.2"/>
            <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="overhead_camera_mount_joint" type="fixed">
        <!-- xArm 1S extended height ~0.35 m + 0.35 m clearance = 0.70 m above base -->
        <origin rpy="0 0 0" xyz="0.0 0.0 0.70"/>
        <parent link="xarm_base_link"/>
        <child link="overhead_camera_mount"/>
    </joint>

    <joint name="overhead_camera_joint" type="fixed">
        <origin rpy="0 1.5708 0" xyz="0 0 -0.02"/>
        <parent link="overhead_camera_mount"/>
        <child link="overhead_camera_link"/>
    </joint>

    <!-- Optical frame per REP-103: Z forward, X right, Y down.
         Body frame (overhead_camera_link) is X-forward, Z-up.
         Rotation: Rz(-pi/2) * Rx(-pi/2). -->
    <link name="overhead_camera_optical_frame"/>
    <joint name="overhead_camera_optical_joint" type="fixed">
        <origin rpy="-1.5707963 0 -1.5707963" xyz="0 0 0"/>
        <parent link="overhead_camera_link"/>
        <child link="overhead_camera_optical_frame"/>
    </joint>

    <!-- RGB camera -->
    <gazebo reference="overhead_camera_link">
        <sensor type="camera" name="overhead_rgb">
            <always_on>true</always_on>
            <update_rate>30.0</update_rate>
            <camera name="overhead_rgb">
                <horizontal_fov>1.0472</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip><near>0.1</near><far>3.0</far></clip>
            </camera>
            <plugin name="overhead_rgb_plugin" filename="libgazebo_ros_camera.so">
                <camera_name>overhead_rgb</camera_name>
                <frame_name>overhead_camera_optical_frame</frame_name>
            </plugin>
        </sensor>
    </gazebo>

    <!-- Depth camera -->
    <gazebo reference="overhead_camera_link">
        <sensor type="depth" name="overhead_depth">
            <always_on>true</always_on>
            <update_rate>30.0</update_rate>
            <camera name="overhead_depth">
                <horizontal_fov>1.0472</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip><near>0.1</near><far>3.0</far></clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.002</stddev>
                </noise>
            </camera>
            <plugin name="overhead_depth_plugin" filename="libgazebo_ros_camera.so">
                <camera_name>overhead_depth</camera_name>
                <frame_name>overhead_camera_optical_frame</frame_name>
                <min_depth>0.1</min_depth>
                <max_depth>3.0</max_depth>
            </plugin>
        </sensor>
    </gazebo>
    <!-- ============================================================
         GRIPPER — scissor-link parallel jaw (xArm1S stock)
         Meshes exported from OnShape in mm → scale 0.001
         ============================================================ -->

    <material name="GripperBlack">
        <color rgba="0.12 0.12 0.12 1.0"/>
    </material>

    <!-- Gripper base: fixed to xarm_2_link -->
    <link name="gripper_base_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://xarm1s_description/meshes/gripper_base.stl"
                      scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="Blue"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://xarm1s_description/meshes/gripper_base.stl"
                      scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.1"/>
            <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="gripper_base_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="xarm_2_link"/>
        <child  link="gripper_base_link"/>
    </joint>

    <!-- Left finger -->
    <link name="gripper_left_finger_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://xarm1s_description/meshes/gripper_left_finger.stl"
                      scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="GripperBlack"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://xarm1s_description/meshes/gripper_left_finger.stl"
                      scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.02"/>
            <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="gripper_left_finger_joint" type="revolute">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit effort="15" lower="-0.45" upper="0.1" velocity="2.0"/>   <!-- ← small -->
        <parent link="gripper_base_link"/>
        <child  link="gripper_left_finger_link"/>
    </joint>

    <!-- Right finger (mimics left) -->
    <link name="gripper_right_finger_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://xarm1s_description/meshes/gripper_right_finger.stl"
                      scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="GripperBlack"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://xarm1s_description/meshes/gripper_right_finger.stl"
                      scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.02"/>
            <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="gripper_right_finger_joint" type="revolute">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <axis xyz="0 1 0"/>
        <!-- Right finger limits are the ANTI-MIRROR of the left finger
             (-0.45..+0.10) so we can drive right = -left over the full
             range without clamping. Closed: left=+0.10, right=-0.10. -->
        <limit effort="15" lower="-0.10" upper="0.45" velocity="2.0"/>
        <parent link="gripper_base_link"/>
        <child  link="gripper_right_finger_link"/>
        <!-- Right finger is commanded directly by gripper_controller with the
             opposite sign — Humble's gazebo_ros2_control does not reliably
             honor URDF <mimic> for actuated joints, so we drive both. -->
    </joint>

    <!-- Tool tip / grasp frame for MoveIt / IK -->
    <link name="gripper_tip_link"/>
    <joint name="gripper_tip_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0.09"/>
        <parent link="gripper_base_link"/>
        <child  link="gripper_tip_link"/>
    </joint>

    <transmission name="trans_gripper_left_finger_joint">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="gripper_left_finger_joint">
            <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        </joint>
        <actuator name="gripper_left_finger_joint_motor">
            <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>
</robot>