<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="tabletop">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- Grasp-friendly ODE physics (Gazebo defaults explode light parts on
         contact). contact_max_correcting_vel caps the penetration-correction
         velocity (default 100 m/s) so a momentarily-penetrating object is
         eased apart instead of flung across the room (this is what ejected the
         52mm coke at release); more solver iters + a thin surface layer make
         the parallel-jaw contact stable. (JenniferBuehler gazebo-pkgs grasp
         physics profile.) -->
    <physics name="grasp_ode" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>1.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- gazebo_ros_state: publishes /model_states (gazebo_msgs/ModelStates)
         with the world-frame pose of every spawned model. Required by the
         evaluation node to obtain ground-truth object positions. -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/</namespace></ros>
      <update_rate>30.0</update_rate>
    </plugin>

    <!-- Contact-triggered grasp (xarm1s_grasp_plugin): /grasp/attach MODEL
         ARMS the object; the plugin welds it rigidly to the gripper
         (xarm_2_link) only once BOTH fingers are in sustained contact with it
         (grip_time), so the gripper must genuinely close on the object first
         (no grip-on-air, no teleport). fallback_timeout welds anyway after a
         timeout if no contact is detected (demo robustness; set 0 to require
         real contact). /grasp/detach MODEL releases it. -->
    <plugin name="link_attacher" filename="libxarm1s_link_attacher.so">
      <ros><namespace>/</namespace></ros>
      <gripper_model>xarm1s</gripper_model>
      <gripper_link>xarm_2_link</gripper_link>
      <left_finger_link>gripper_left_finger_link</left_finger_link>
      <right_finger_link>gripper_right_finger_link</right_finger_link>
      <grip_time>0.05</grip_time>
      <fallback_timeout>1.0</fallback_timeout>
    </plugin>

    <!-- Table: top surface at z = 0.75 -->
    <model name="table">
      <static>true</static>
      <link name="link">
        <pose>0 0 0.375 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 0.75</size></box></geometry>
          <material><ambient>0.5 0.3 0.1 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.8 0.8 0.75</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Green drop plate: the shared destination for all placed objects. Green
         so it matches NO object's HSV range (never detected as an object).
         VISUAL ONLY + FLUSH with the table (2 mm disk ~1 mm proud) so the depth
         camera ignores it (under the 5 mm above-table object threshold) and
         there is no rim for objects to clip into. -->
    <model name="drop_plate">
      <static>true</static>
      <link name="link">
        <pose>0.23 0.0 0.750 0 0 0</pose>
        <visual name="visual">
          <geometry><cylinder><radius>0.12</radius><length>0.002</length></cylinder></geometry>
          <material>
            <ambient>0.0 0.35 0.0 1</ambient>
            <diffuse>0.1 0.85 0.1 1</diffuse>
            <specular>0.05 0.1 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Coke can (cylinder, h=0.115m, r=0.033m): base on table → z = 0.75 + 0.115/2 -->
    <include>
      <name>coke_can</name>
      <pose>0.14 0.11 0.776 1.5708 0 0</pose>
      <uri>model://coke_can</uri>
    </include>

    <!-- Banana (lying flat): center ~2cm above table -->
    <include>
      <name>banana</name>
      <pose>0.14 -0.11 0.80 0 0 0</pose>
      <uri>model://banana</uri>
    </include>

    <!-- Golf ball (sphere r=0.0214m): center at z = 0.75 + 0.0214 -->
    <include>
      <name>golf_ball</name>
      <pose>-0.14 0.11 0.80 0 0 0</pose>
      <uri>model://golf_ball</uri>
    </include>

    <!-- Blue cardboard box (60x40x30mm) primitive, kept inline -->
    <model name="blue_box">
      <pose>-0.14 -0.11 0.80 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.060 0.040 0.030</size></box></geometry>
          <material>
            <ambient>0.0 0.1 0.5 1</ambient>
            <diffuse>0.0 0.2 0.9 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.060 0.040 0.030</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>1.5</mu><mu2>1.5</mu2></ode>
            </friction>
            <contact>
              <ode><kp>1e5</kp><kd>10</kd><min_depth>0.001</min_depth><max_vel>0.1</max_vel></ode>
            </contact>
          </surface>
        </collision>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
      </link>
    </model>

  </world>
</sdf>
