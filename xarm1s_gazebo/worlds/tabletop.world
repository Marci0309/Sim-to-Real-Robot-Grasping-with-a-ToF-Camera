<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="tabletop">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <model name="table">
      <static>true</static>
      <link name="link">
        <pose>0 0 0.375 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 0.75</size></box></geometry>
          <material><ambient>0.5 0.3 0.1 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.8 0.8 0.75</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="cube">
      <pose>0.1 0.0 0.78 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>1 0 0 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        </collision>
        <inertial><mass>0.1</mass></inertial>
      </link>
    </model>

    <model name="cylinder">
      <pose>-0.1 0.1 0.78 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.025</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0 0 1 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.025</radius><length>0.08</length></cylinder></geometry>
        </collision>
        <inertial><mass>0.1</mass></inertial>
      </link>
    </model>

  </world>
</sdf>
