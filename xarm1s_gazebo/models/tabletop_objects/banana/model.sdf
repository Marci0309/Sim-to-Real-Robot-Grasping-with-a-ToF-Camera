<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="banana">
    <link name="link">
      <inertial>
        <mass>0.120</mass>
        <inertia>
          <ixx>0.0001</ixx><iyy>0.0003</iyy><izz>0.0003</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://banana/meshes/banana_decimated.obj</uri>
            <scale>0.02655 0.02655 0.02655</scale>
          </mesh>
        </geometry>
      </visual>
      <!-- Collision: a compact box matching the body (was 0.18x0.04x0.04, whose
           long ends dipped/penetrated during the rigid carry and ejected the
           banana on release). Smaller -> no stored force. -->
      <collision name="collision">
        <geometry>
          <box><size>0.12 0.03 0.03</size></box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
