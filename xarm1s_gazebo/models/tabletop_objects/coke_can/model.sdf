<?xml version="1.0" ?>
<sdf version="1.6">
  <!-- Slim 250 ml can: primitive red cylinder, 52 mm dia x 134 mm. Replaces the
       thick 330 ml Sketchfab mesh (66 mm dia) which was too wide for the gripper
       and carried an ~80 mm centroid mesh-bias. As a clean primitive it grasps
       across its 52 mm diameter (< ~80 mm jaw opening) and has no mesh artefact.
       All-red surface -> clean HSV detection (red dual-range in pose_estimator),
       no overlap with golf_ball magenta / banana yellow / blue_box blue. -->
  <model name="coke_can">
    <link name="link">
      <inertial>
        <mass>0.050</mass>
        <inertia>
          <ixx>0.000083</ixx><iyy>0.000083</iyy><izz>0.000017</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://coke_can/meshes/coke_slim_250ml.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.5 0.0 0.0 1</ambient>
          <diffuse>0.9 0.1 0.1 1</diffuse>
          <specular>0.1 0.05 0.05 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.026</radius>
            <length>0.134</length>
          </cylinder>
        </geometry>
        <!-- Grippy + soft contact so the jaws register a stable grasp contact
             (kp/kd softer than the 1e12 default that flings light parts);
             torsional friction stops the lying cylinder from spinning. -->
        <surface>
          <friction>
            <ode><mu>1.5</mu><mu2>1.5</mu2></ode>
            <torsional><coefficient>1.0</coefficient></torsional>
          </friction>
          <contact>
            <ode><kp>1e5</kp><kd>10</kd><min_depth>0.001</min_depth><max_vel>0.1</max_vel></ode>
          </contact>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
